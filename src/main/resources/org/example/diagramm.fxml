<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.DiagramController"
            stylesheets="@style.css"
            prefWidth="600" prefHeight="850">
    <top>
        <Label text="Diagramme" styleClass="title" style="-fx-font-size: 22px;">
            <BorderPane.margin>
                <Insets top="20" left="20" bottom="10" right="20"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="10">
                <padding>
                    <Insets left="20" right="20" bottom="20"/>
                </padding>

                <Label text="Gewichtsverlauf" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <StackPane prefHeight="300">
                    <LineChart fx:id="weightChart">
                        <xAxis>
                            <CategoryAxis fx:id="weightXAxis" label="Datum"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="weightYAxis" label="Gewicht (kg)" forceZeroInRange="false"/>
                        </yAxis>
                    </LineChart>
                    <Label fx:id="weightEmptyHintLabel"
                           text="Noch keine Gewichtsdaten vorhanden. Bitte im Hauptfenster ein Gewicht speichern."
                           wrapText="true" visible="false" managed="false"/>
                </StackPane>

                <Label text="Trainingsfrequenz" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <StackPane prefHeight="300">
                    <BarChart fx:id="trainingChart" styleClass="training-chart">
                        <xAxis>
                            <CategoryAxis fx:id="trainingXAxis" label="Monat"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="trainingYAxis" label="Trainierte Tage"/>
                        </yAxis>
                    </BarChart>
                    <Label fx:id="trainingEmptyHintLabel"
                           text="Noch keine Kalender-Einträge vorhanden. Bitte im Kalender Trainingstage eintragen."
                           wrapText="true" visible="false" managed="false"/>
                </StackPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
