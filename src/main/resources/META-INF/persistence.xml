<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">
    <persistence-unit name="todo-unit">
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>org.example.entity.User</class>
        <class>org.example.entity.BodyMeasurement</class>
        <class>org.example.entity.Exercise</class>
        <class>org.example.entity.Workout</class>
        <class>org.example.entity.WorkoutExercise</class>
        <class>org.example.entity.Meal</class>
        <class>org.example.entity.MealPlan</class>
        <class>org.example.entity.CalendarEntry</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/fitnessdb"/>
            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="Selimleila0309"/>
            <property name="hibernate.hbm2ddl.auto"
                      value="create"/>
            <property name="hibernate.show_sql"
                      value="true"/>
            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>
    </persistence-unit>
</persistence>
